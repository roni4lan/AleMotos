# ============================================
# Ale Motos — Variables de Entorno
# ============================================
# Copiar este archivo a .env y completar los valores reales.
# NUNCA subir el .env real al repositorio.

# --- Base de Datos (PostgreSQL) ---
POSTGRES_USER=ale_motos_user
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
POSTGRES_DB=ale_motos
DB_PORT=5432

# --- Backend ---
NODE_ENV=development
BACKEND_PORT=3000
JWT_SECRET=CAMBIAR_POR_SECRET_SEGURO_MINIMO_32_CARACTERES
JWT_EXPIRES_IN=24h

# --- Frontend ---
FRONTEND_PORT=5173

# --- Rate Limiting (Portal Cliente) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# --- Negocio (configurables) ---
BUSINESS_NAME=Ale Motos
